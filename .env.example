NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Private development-only credentials. Generate with npm run dev:account.
# Never prefix these with NEXT_PUBLIC_.
DEV_TEST_EMAIL=testing@finori.test
DEV_TEST_PASSWORD=

# Private server credentials. Never use NEXT_PUBLIC_ for these values.
# Local value: npx supabase status (SECRET_KEY or legacy SERVICE_ROLE_KEY).
SUPABASE_SECRET_KEY=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DRIVE_TOKEN_ENCRYPTION_KEY=
# Google Cloud OAuth Client (Web application); see docs/google-drive.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/drive/callback
